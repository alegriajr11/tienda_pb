<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light">
		<meta name="supported-color-schemes" content="light">
		<title>Código de inicio de sesión</title>
	</head>
	<body style="margin: 0; padding: 0; background-color: #f4f6f5; color: #202824; font-family: Arial, Helvetica, sans-serif;">
		<div style="display: none; max-height: 0; overflow: hidden; opacity: 0;">
			Tu código temporal para iniciar sesión.
		</div>
		<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f6f5;">
			<tr>
				<td align="center" style="padding: 40px 16px;">
					<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 480px; background-color: #ffffff; border: 1px solid #e3e8e5;">
						<tr>
							<td style="padding: 32px 32px 8px;">
								<p style="margin: 0 0 8px; color: #47745b; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">Seguridad de la cuenta</p>
								<h1 style="margin: 0; color: #202824; font-size: 24px; line-height: 1.3; font-weight: 600;">Inicia sesión</h1>
							</td>
						</tr>
						<tr>
							<td style="padding: 8px 32px 24px;">
								<p style="margin: 0; color: #53615a; font-size: 15px; line-height: 1.6;">Usa este código temporal para completar el inicio de sesión:</p>
							</td>
						</tr>
						<tr>
							<td align="center" style="padding: 0 32px 24px;">
								<p style="display: inline-block; margin: 0; padding: 16px 24px; border: 1px solid #dce5df; background-color: #f7faf8; color: #202824; font-size: 30px; line-height: 1; font-weight: 700; letter-spacing: 8px;">
									{{otpCode}}
								</p>
							</td>
						</tr>
						<tr>
							<td style="padding: 0 32px 32px;">
								<p style="margin: 0 0 12px; color: #53615a; font-size: 14px; line-height: 1.6;">No compartas este código con nadie. El equipo de soporte nunca te lo solicitará.</p>
								<p style="margin: 0; color: #748078; font-size: 13px; line-height: 1.6;">Si no solicitaste este inicio de sesión, puedes ignorar este correo.</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
